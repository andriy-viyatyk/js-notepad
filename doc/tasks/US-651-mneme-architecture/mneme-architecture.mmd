flowchart TB
    subgraph clients[" Clients "]
        PR["Persephone renderer<br/>(MnemeProvider + MCP client)"]
        PM["Persephone main<br/>(child-process manager)"]
        AG["AI agents<br/>(MCP client)"]
    end

    subgraph mneme[" Mneme service — single self-contained Rust binary "]
        MCP["MCP server — sole interface<br/>(Streamable HTTP + stdio,<br/>bearer / OAuth auth)<br/>tools = actions · resources = content"]

        subgraph core[" Core services "]
            DS["Document Store<br/>(FS over wiki roots,<br/>safe path resolution)"]
            FM["Frontmatter parser +<br/>Markdown chunker"]
            IDX["Indexer<br/>(sync orchestrator + work queue)"]
            EMB["Embedding Engine<br/>(ort / ONNX in-process,<br/>DirectML GPU → CPU fallback)"]
            SE["Search Engine<br/>(metadata filter + FTS5 + vector,<br/>RRF merge)"]
        end

        WATCH["File Watcher<br/>(notify, debounced)"]
        PROV["Model Provisioner<br/>(download + checksum)"]
        CFG["Config<br/>(roots, model, transport, token, GPU)"]
    end

    subgraph storage[" Storage "]
        DB[("SQLite index<br/>sqlite-vec + FTS5<br/>(rebuildable)")]
        FILES["Wiki root folders<br/>markdown + attachments<br/>(source of truth)"]
        MODEL["ONNX model<br/>+ tokenizer<br/>(cache dir)"]
    end

    PR -->|"MCP (stdio local / HTTP remote)"| MCP
    PM -.->|spawn / health / shutdown| mneme
    AG -->|MCP| MCP

    MCP -->|tools| DS
    MCP -->|tools| SE
    MCP -->|tools| IDX
    MCP -->|resources| DS

    DS <-->|read / write| FILES
    DS --> FM
    FM --> IDX
    IDX --> EMB
    IDX -->|upsert / delete| DB
    EMB -->|load / infer| MODEL
    SE -->|FTS5 + KNN| DB
    SE -->|embed query| EMB

    WATCH -->|change events| IDX
    WATCH -. watches .-> FILES
    PROV -->|provision| MODEL
    CFG -. configures .-> mneme
