flowchart TB
    START["Script starts"] --> CREATE["releaseList = []"]
    CREATE --> RUN["Execute script code"]

    RUN --> |"page.asGrid()"| FAC1["return stateless<br/>GridEditorFacade<br/><i>no release fn</i>"]
    RUN --> |"page.asText()"| FAC2["return stateless<br/>TextEditorFacade<br/><i>no release fn</i>"]
    RUN --> |"app.events.X.subscribe(h)"| SUB["push unsubscribe()<br/>onto releaseList"]

    FAC1 --> RUN
    FAC2 --> RUN
    SUB --> RUN

    RUN --> |"success or error"| FINALLY["finally block"]
    FINALLY --> CLEANUP["context.dispose()"]
    CLEANUP --> REL["Iterate releaseList<br/>→ unsubscribe each handler"]
    REL --> DONE["All subscriptions cleaned ✓<br/>Editor facades were stateless"]

    style START fill:#e8f5e9
    style FINALLY fill:#fff3e0
    style CLEANUP fill:#ffebee
    style DONE fill:#e8f5e9
